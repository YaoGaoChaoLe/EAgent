# 发送消息并等待回复（智谱清言 · 全能工具，CDP 注入 / 轮询）
#
# 长文本
#   第 1 步：先把 Base64 写进文件（UTF-8 无 BOM）， {{运行目录}}\msg.b64。内容形如 5L2g5aW977yM...（纯 Base64 字符串）
#   powershell -NoProfile -ExecutionPolicy Bypass -Command "& '{{运行目录}}\2_发送并等待回复.ps1' -MessageB64 '{{运行目录}}\msg.b64'"
#
# 长文本 + 附带文件
#   powershell -NoProfile -ExecutionPolicy Bypass -Command "& '{{运行目录}}\2_发送并等待回复.ps1' -Files \"文件名\",\"文件名\" -MessageB64 '{{运行目录}}\msg.b64'"
param(
    [string]$Message = "",
    [string]$MessageB64 = "",
    [string[]]$Files = @(),
    [int]$Port = 7891,
    [int]$Timeout = 180,
    [string]$OutputFile = "",
    [string]$Encoding = "gbk",
    [switch]$Quiet = $false,
    [int]$FastFailSec = 15
)
$script:DbgT0 = Get-Date
function Dbg([string]$msg, [string]$color = 'DarkGray') {
    if ($Quiet) { return }
    $ms = [int]((Get-Date) - $script:DbgT0).TotalMilliseconds
    Write-Host ("[{0,7}ms] {1}" -f $ms, $msg) -ForegroundColor $color
}

if ($PSScriptRoot) { $WorkDir = $PSScriptRoot } else { $WorkDir = (Get-Location).Path }
if (-not $OutputFile) { $OutputFile = Join-Path $WorkDir "reply.txt" }
Dbg ("参数 Message={0}字 B64={1} Files={2} Port={3} Timeout={4}s Out={5} Enc={6} Quiet={7}" -f $Message.Length, $MessageB64.Length, $Files.Count, $Port, $Timeout, $OutputFile, $Encoding, $Quiet) 'Cyan'
Dbg ("工作目录={0}" -f $WorkDir) 'Cyan'

$UrlMatch = 'chatglm\.cn'
$Selectors = @{
    input   = @('textarea.scroll-display-none', 'textarea')
    sendBtn = @('div.enter.is-main-chat', 'div.enter-icon-container', 'div.enter')
}

# pick 辅助函数（注入 / 发送共用，按选择器列表去重取元素）
$SelJson = ($Selectors | ConvertTo-Json -Compress)
$SelJs = @"
var SEL = $SelJson;
function pick(key){
    var list = SEL[key]||[];
    if(typeof list==='string') list=[list];
    var out=[], seen=[];
    for(var i=0;i<list.length;i++){
        var els=document.querySelectorAll(list[i]);
        for(var j=0;j<els.length;j++){
            if(seen.indexOf(els[j])<0){ seen.push(els[j]); out.push(els[j]); }
        }
    }
    return out;
}
"@

# 取回复 / 取计数 / 生成态探测 的 JS
$chatglmHelpers = @'
function lastAnswer(){ var as=document.querySelectorAll('div.answer'); return as[as.length-1]||null; }
function lastAnswerText(){
    var a=lastAnswer();
    if(!a) return '';
    var ats=a.querySelectorAll('.advance-thinking');
    for(var k=0;k<ats.length;k++){
        if(!/collapse/.test(ats[k].className||'')) return '';
    }
    var wraps=a.querySelectorAll('.answer-content-wrap');
    var out=[];
    for(var i=0; i<wraps.length; i++){
        var w = wraps[i];
        if(/text-advance-thinking-content/.test(w.className||'')) continue;
        var clone = w.cloneNode(true);
        var blks = clone.querySelectorAll('.code-no-artifacts');
        for (var k2=0; k2<blks.length; k2++) {
            var blk = blks[k2];
            var lang = 'text';
            var langEl = blk.querySelector('.top-outer .language');
            if (langEl) {
                var l = (langEl.textContent||'').trim();
                if (l) lang = l;
            }
            var extractText = function(node) {
                var text = '';
                for (var c=0; c<node.childNodes.length; c++) {
                    var child = node.childNodes[c];
                    if (child.nodeType === 3) {
                        text += child.nodeValue;
                    } else if (child.nodeType === 1) {
                        var tag = child.tagName.toLowerCase();
                        if (tag === 'br') {
                            text += '\n';
                        } else {
                            text += extractText(child);
                            if (tag === 'div' || tag === 'p' || tag === 'pre') {
                                if (text.length > 0 && text[text.length-1] !== '\n') {
                                    text += '\n';
                                }
                            }
                        }
                    }
                }
                return text;
            };
            var codeEl = blk.querySelector('pre > code');
            var codeText = codeEl ? extractText(codeEl) : '';
            codeText = codeText.replace(/^\n+|\n+$/g, '');
            var md = '\n\n```' + lang + '\n' + codeText + '\n```\n\n';
            var textNode = document.createTextNode(md);
            if (blk.parentNode) { blk.parentNode.replaceChild(textNode, blk); }
        }
        var bads = clone.querySelectorAll('.copy-button, .top-outer, .interact-container, .line-numbers-rows');
        for (var j=0; j<bads.length; j++) { if (bads[j].parentNode) bads[j].remove(); }
        clone.style.whiteSpace = 'pre-wrap';
        var txt = (clone.innerText || clone.textContent || '').trim();
        txt = txt.replace(/\n{3,}/g, '\n\n');
        if (txt) out.push(txt);
    }
    return out.join('\n\n');
}
'@

$msgJs = $chatglmHelpers + @"
(function(){
    var n=document.querySelectorAll('div.answer').length;
    return JSON.stringify({count:n, text:lastAnswerText()});
})()
"@

$userJs = @"
(function(){
    return JSON.stringify({count: document.querySelectorAll('div.conversation.question, div.question').length});
})()
"@

$btnJs = $chatglmHelpers + @"
(function(){
    var a=lastAnswer();
    var generating=false;
    if(a){
        var at=a.querySelector('.advance-thinking');
        if(at && !/collapse/.test(at.className||'')) generating=true;
    }
    var qs=document.querySelectorAll('div.conversation.question, div.question');
    return JSON.stringify({ok:true, isStop:generating, isArrow:!generating, head:'', userCount: qs.length});
})()
"@

$lastAssistJs = $chatglmHelpers + @"
(function(){ return lastAnswerText(); })()
"@

$statusJs = $chatglmHelpers + @"
(function(){
    var a=lastAnswer();
    var es=document.querySelectorAll('div.enter.is-main-chat');
    var searching=false;
    for(var i=0;i<es.length;i++){ if(/searching/.test((es[i].className||''))){ searching=true; break; } }
    return JSON.stringify({text:(a?lastAnswerText():''), searching:searching});
})()
"@

if ($MessageB64) {
    if (Test-Path -LiteralPath $MessageB64 -PathType Leaf) {
        $MessageB64 = [IO.File]::ReadAllText((Resolve-Path -LiteralPath $MessageB64).Path).Trim()
    }
    try {
        $bytes = [Convert]::FromBase64String($MessageB64)
        $Message = [Text.Encoding]::UTF8.GetString($bytes)
    } catch { Write-Output "ERROR: MessageB64 decode failed"; exit 1 }
}
if ([string]::IsNullOrEmpty($Message) -and $Files.Count -eq 0) { Write-Output "ERROR: no message"; exit 1 }

Dbg ("查询调试端口 {0} 页面列表..." -f $Port) 'Cyan'
$pages = Invoke-RestMethod -Uri "http://127.0.0.1:$Port/json" -TimeoutSec 5
$target = $pages | Where-Object { $_.url -match $UrlMatch -and $_.type -eq 'page' } | Select-Object -First 1
if (-not $target) { Write-Output "ERROR: no chatglm page"; exit 1 }
Dbg ("目标页面 url={0}" -f $target.url) 'Cyan'

$ws = New-Object System.Net.WebSockets.ClientWebSocket
$ws.ConnectAsync([Uri]$target.webSocketDebuggerUrl, [Threading.CancellationToken]::None).Wait(5000) | Out-Null
if ($ws.State -ne 'Open') { Write-Output "ERROR: WS not open"; exit 1 }
Dbg "WebSocket 已连接" 'Cyan'

$script:cdpId = 0

function CDPRecv([int]$id, [int]$timeoutMs) {
    $deadline = (Get-Date).AddMilliseconds($timeoutMs)
    $pattern = '"id"\s*:\s*' + $id + '\b'
    try {
        while ((Get-Date) -lt $deadline) {
            $ms = New-Object System.IO.MemoryStream
            $buf = New-Object byte[] 4194304
            $done = $false
            while (-not $done) {
                $left = [int]($deadline - (Get-Date)).TotalMilliseconds
                if ($left -lt 1) { break }
                $seg = New-Object System.ArraySegment[byte] -ArgumentList @(,$buf)
                $task = $ws.ReceiveAsync($seg, [Threading.CancellationToken]::None)
                if (-not $task.Wait($left)) { break }
                $rr = $task.Result
                if ($rr.Count -gt 0) { $ms.Write($buf, 0, $rr.Count) }
                if ($rr.EndOfMessage) { $done = $true }
            }
            if ($ms.Length -gt 0) {
                $text = [Text.Encoding]::UTF8.GetString($ms.ToArray())
                $ms.Dispose()
                foreach ($line in ($text -split "`n")) {
                    if ($line -match $pattern) {
                        try { return ($line | ConvertFrom-Json) } catch {}
                    }
                }
            } else { $ms.Dispose() }
        }
    } catch {
        Write-Output "ERROR: WS_RECV_FAIL: $($_.Exception.Message)"
        return $null
    }
    return $null
}

function CDPCall([string]$method, $params, [int]$timeoutMs = 8000) {
    try {
        $script:cdpId++; $id = $script:cdpId
        $dbgPs = ''
        if ($null -ne $params) {
            try { $dbgPs = ($params | ConvertTo-Json -Compress -Depth 4) } catch { $dbgPs = '<json?>' }
        }
        if ($dbgPs.Length -gt 150) { $dbgPs = $dbgPs.Substring(0,150) + '…' }
        Dbg ("CDP>> #{0} {1} {2}" -f $id, $method, $dbgPs) 'Magenta'
        $payload = @{ id=$id; method=$method; params=$params } | ConvertTo-Json -Depth 20 -Compress
        $bytes = [Text.Encoding]::UTF8.GetBytes($payload)
        $seg = New-Object System.ArraySegment[byte] -ArgumentList @(,$bytes)
        $sendTask = $ws.SendAsync($seg, [System.Net.WebSockets.WebSocketMessageType]::Text, $true, [Threading.CancellationToken]::None)
        if (-not $sendTask.Wait(3000)) { Write-Output "ERROR: CDP_SEND_TIMEOUT: $method"; return $null }
        $resp = CDPRecv $id $timeoutMs
        Dbg ("CDP<< #{0} {1}" -f $id, $(if ($null -eq $resp) { 'NULL' } else { 'OK' })) 'Magenta'
        if ($resp -and $resp.result) { return $resp.result }
        return $null
    } catch {
        Write-Output "ERROR: CDP_$method : $($_.Exception.Message)"
        return $null
    }
}

function CDP([string]$expr, [int]$timeoutMs = 8000) {
    $r = CDPCall 'Runtime.evaluate' @{ expression=$expr; returnByValue=$true } $timeoutMs
    if ($r -and $r.result) { return $r.result.value }
    return $null
}

$null = CDPCall 'Page.enable' @{}
$null = CDPCall 'Page.bringToFront' @{}
$null = CDPCall 'Emulation.setFocusEmulationEnabled' @{enabled=$true}
Write-Output "KEEPALIVE_SET"
Dbg "页面保持活跃已设置" 'DarkGray'

# 自动关闭弹窗（活动横幅 / 新手引导等），避免挡住输入框
$null = CDP @"
(function(){
    var c = Array.from(document.querySelectorAll('button, [role="button"], div')).find(function(e){
        var t=(e.textContent||'').trim();
        return (t==='我知道了'||t==='知道了'||t==='关闭') && e.offsetParent!==null;
    });
    if(c){ c.click(); return 'DISMISSED'; }
    return 'NONE';
})()
"@

$initCount = 0
$cv = CDP $msgJs -timeoutMs 4000
if ($cv) { try { $initCount = [int](($cv | ConvertFrom-Json).count) } catch {} }

$uInit = 0
$uv = CDP $userJs -timeoutMs 4000
if ($uv) { try { $uInit = [int](($uv | ConvertFrom-Json).count) } catch {} }

$lastAssist0 = CDP $lastAssistJs -timeoutMs 4000
if ($null -eq $lastAssist0) { $lastAssist0 = '' }
Write-Output "INIT_COUNT: a=$initCount u=$uInit"
Write-Output "PREV_ASSIST_LEN: $($lastAssist0.Length)"
Dbg ("初始计数 助手={0} 用户={1} 发送前末条长度={2}" -f $initCount, $uInit, $lastAssist0.Length) 'Cyan'

if ($Files.Count -gt 0) {
    $abs = @()
    foreach ($f in $Files) {
        if (-not (Test-Path -LiteralPath $f)) { Write-Output "ERROR: file not found: $f"; $ws.Dispose(); exit 1 }
        $abs += (Resolve-Path -LiteralPath $f).Path
    }
    $null = CDPCall 'DOM.enable' @{}
    $objRes = CDPCall 'Runtime.evaluate' @{ expression = 'document.querySelector(''input.el-upload__input'') || document.querySelector(''input[type="file"]:not(.img-input)'') || document.querySelector(''input[type="file"]'')'; returnByValue = $false }
    if (-not $objRes -or -not $objRes.result -or -not $objRes.result.objectId) { Write-Output "ERROR: no file input"; $ws.Dispose(); exit 1 }
    $objectId = $objRes.result.objectId
    Dbg ("上传文件 {0} 个: {1}" -f $abs.Count, ($abs -join '; ')) 'Cyan'
    $null = CDPCall 'DOM.setFileInputFiles' @{ files = $abs; objectId = $objectId }
    Write-Output "FILES_SET: $($abs.Count)"
    Start-Sleep -Seconds 3
}

$msgJson = $Message | ConvertTo-Json -Compress
$injectJs = $SelJs + @"
(function(){
    var msg = $msgJson;
    var ta = pick('input')[0];
    if(!ta) return JSON.stringify({ok:false, err:'no textarea'});
    ta.focus();
    var s = Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype, 'value').set;
    s.call(ta, msg);
    ta.dispatchEvent(new Event('input',{bubbles:true}));
    ta.dispatchEvent(new Event('change',{bubbles:true}));
    return JSON.stringify({ok:true, len:ta.value.length});
})()
"@
Dbg ("注入消息 长度={0}" -f $Message.Length) 'Cyan'
$r = CDP $injectJs
if (-not $r -or $r -notmatch '"ok":true') {
    Write-Output "ERROR: inject failed ($r)"
    $ws.Dispose(); exit 1
}
Write-Output "INJECTED"

Start-Sleep -Milliseconds 300

if ([string]::IsNullOrEmpty($Message)) {
    $sendJs = $SelJs + @"
(function(){
    var btns = pick('sendBtn');
    var btn=null,w=window.innerWidth,h=window.innerHeight;
    for(var i=0;i<btns.length;i++){
        var el=btns[i];
        if(el.offsetParent===null) continue;
        var r=el.getBoundingClientRect();
        if(r.x<w*0.5||r.y<h*0.6) continue;
        btn=el;
    }
    if(!btn) return 'NO_BTN';
    btn.click();
    return 'SENT';
})()
"@
} else {
    $sendJs = $SelJs + @"
(function(){
    var ta = pick('input')[0];
    if(!ta) return 'NO_TA';
    ta.focus();
    function ev(t){
        var e = new KeyboardEvent(t, {key:'Enter', code:'Enter', keyCode:13, which:13, bubbles:true, cancelable:true});
        ta.dispatchEvent(e);
    }
    ev('keydown'); ev('keypress'); ev('keyup');
    return 'SENT';
})()
"@
}
Dbg ("执行发送 模式={0}" -f $(if ([string]::IsNullOrEmpty($Message)) { '按钮点击' } else { '输入框回车' })) 'Cyan'
$r = CDP $sendJs
if ($r -ne 'SENT') {
    Write-Output "ERROR: send failed ($r)"
    $ws.Dispose(); exit 1
}
Write-Output "SEND_ACTION: SENT"

$deadline = (Get-Date).AddSeconds($Timeout)
$finalText = ""
$prevText = $lastAssist0
$stableTicks = 0
$requiredStable = 2   # searching=false 连续 2 次(200ms)即判定完成
$sawNew = $false
$nullTicks = 0
$requiredNull = 10
$ctxWarn = $false
$cdpBroken = $false
$tick = 0
$failFastDeadline = (Get-Date).AddSeconds($FastFailSec)
$sawStop = $false
$failFast = $false
$btnProbe = 0
Dbg ("进入轮询 超时={0}s 判定稳定次数={1} 判定断开次数={2}" -f $Timeout, $requiredStable, $requiredNull) 'Cyan'

while ((Get-Date) -lt $deadline) {
    Start-Sleep -Milliseconds 100
    $tick++

    if ($tick -eq 1 -or ($tick % 10) -eq 0) {
        Dbg ("轮询#{0} 新={1} 完成计数={2}/{3} searching={4} 空={5}/{6}" -f $tick, $sawNew, $stableTicks, $requiredStable, $isSearching, $nullTicks, $requiredNull) 'DarkGray'
    }

    $st = CDP $statusJs -timeoutMs 5000
    if ($null -eq $st) {
        $nullTicks++
        if (-not $ctxWarn -and $nullTicks -ge 3) {
            $ctxWarn = $true
            Write-Output "WARN: CTX_HEAVY_OR_CDP_SLOW: null_ticks=$nullTicks"
            Dbg ("CDP 取空 {0}/{1}" -f $nullTicks, $requiredNull) 'Yellow'
        }
        if ($nullTicks -ge $requiredNull) {
            $cdpBroken = $true
            Write-Output "ERROR: CDP_BROKEN: 连续 $nullTicks 次无响应，通道疑似断开，建议开启新对话"
            break
        }
        continue
    }
    $nullTicks = 0
    $sObj = $null
    try { $sObj = $st | ConvertFrom-Json } catch {}
    if ($null -eq $sObj) { continue }
    $cur = [string]$sObj.text
    $isSearching = [bool]$sObj.searching

    if (-not $sawNew -and -not $sawStop) {
        if ($isSearching) {
            $sawStop = $true
            Dbg '检测到生成态(searching)' 'Cyan'
        } else {
            $btnProbe++
            if ($btnProbe -ge 10) {
                $btnProbe = 0
                $bv = CDP $btnJs -timeoutMs 3000
                if ($bv) {
                    try {
                        $bj = $bv | ConvertFrom-Json
                        $generating = ($bj.isStop -eq $true) -or ([int]$bj.userCount) -gt $uInit
                        if ($bj.ok -and $generating) { $sawStop = $true; Dbg '检测到生成态' 'Cyan' }
                    } catch {}
                }
                if (-not $sawStop -and (Get-Date) -gt $failFastDeadline) {
                    $failFast = $true
                    Write-Output "ERROR: FAIL_FAST: ${FastFailSec}s 内未进入生成态且无新回复"
                    break
                }
            }
        }
    }

    if (-not $sawNew) {
        if ($cur -ne $lastAssist0 -and $cur.Length -gt 0) {
            Write-Output "  [new-reply] len=$($cur.Length)"
            Dbg ("发现新回复 len={0}" -f $cur.Length) 'Green'
            $sawNew = $true
            $prevText = $cur
        }
        continue
    }

    if (-not $isSearching -and $cur.Length -gt 0) {
        $stableTicks++
        if ($stableTicks -ge $requiredStable) {
            Dbg ("searching=false 连续 {0} 次，判定完成 len={1}" -f $requiredStable, $cur.Length) 'Green'
            $finalText = $cur
            break
        }
    } else {
        if ($stableTicks -gt 0) { Dbg ("  生成中(searching={0})，完成计数清零 len={1}" -f $isSearching, $cur.Length) 'DarkYellow' }
        $stableTicks = 0
        $prevText = $cur
    }
}

Dbg ("轮询结束 用时={0}ms 有结果={1}" -f [int]((Get-Date)-$script:DbgT0).TotalMilliseconds, [bool]$finalText) 'Cyan'
if ($ws.State -eq 'Open') { $ws.Dispose() }
if ($cdpBroken) { exit 3 }
if ($failFast) { exit 4 }

if ($finalText) {
    if ($Encoding.ToLower() -match 'utf-?8') {
        [IO.File]::WriteAllText($OutputFile, $finalText, [Text.UTF8Encoding]::new($false))
    } else {
        $enc = [Text.Encoding]::GetEncoding(936)
        [IO.File]::WriteAllText($OutputFile, $finalText, $enc)
    }
    Dbg ("已写文件 {0} 编码={1}" -f $OutputFile, $(if ($Encoding.ToLower() -match 'utf-?8') { 'UTF8-NOBOM' } else { 'GBK' })) 'Green'
    Write-Output "OK: len=$($finalText.Length) path=$OutputFile"
    Write-Output "----- reply.txt -----"
    Write-Output $finalText
} else {
    Dbg "超时 未等到回复" 'Red'
    Write-Output "TIMEOUT"
    exit 2
}
