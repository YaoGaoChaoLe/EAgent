# 调用例程
# 写到文件 > "{{工作目录}}\diff.ps1"
# powershell -NoProfile -ExecutionPolicy Bypass -File "{{工作目录}}\diff.ps1" "{{目录1}}" "{{目录2}}"
param (
    [Parameter(Mandatory=$true, Position=0)][string]$DirA,
    [Parameter(Mandatory=$true, Position=1)][string]$DirB
)

$ErrorActionPreference = 'Stop'

if (-not (Test-Path -LiteralPath $DirA -PathType Container)) { Write-Host "Dir A does not exist: $DirA" -ForegroundColor Red; exit 1 }
if (-not (Test-Path -LiteralPath $DirB -PathType Container)) { Write-Host "Dir B does not exist: $DirB" -ForegroundColor Red; exit 1 }

$dirA = (Resolve-Path -LiteralPath $DirA).Path.TrimEnd('\')
$dirB = (Resolve-Path -LiteralPath $DirB).Path.TrimEnd('\')

if ($dirA -eq $dirB) { Write-Host "Directories cannot be the same" -ForegroundColor Red; exit 1 }

Write-Host "Scanning Dir A (OLD/Base): $dirA" -ForegroundColor DarkYellow
Write-Host "Scanning Dir B (NEW/Compare): $dirB" -ForegroundColor DarkGreen

$filesA = @{}
$scanErr = @()
Get-ChildItem -LiteralPath $dirA -File -Recurse -ErrorAction SilentlyContinue -ErrorVariable +scanErr | ForEach-Object {
    $rel = $_.FullName.Substring($dirA.Length).TrimStart('\')
    $filesA[$rel] = $_
}

$filesB = @{}
Get-ChildItem -LiteralPath $dirB -File -Recurse -ErrorAction SilentlyContinue -ErrorVariable +scanErr | ForEach-Object {
    $rel = $_.FullName.Substring($dirB.Length).TrimStart('\')
    $filesB[$rel] = $_
}
if ($scanErr.Count -gt 0) { Write-Host "Warning: $($scanErr.Count) path(s) skipped during scan (access denied)." -ForegroundColor Yellow }

$allPaths = @($filesA.Keys) + @($filesB.Keys) | Sort-Object -Unique

$diffData = @()
$skipped = @()

foreach ($path in $allPaths) {
    try {
    $inA = $filesA.ContainsKey($path)
    $inB = $filesB.ContainsKey($path)
    
    $status = ""
    if ($inA -and -not $inB) { $status = "removed" }
    elseif (-not $inA -and $inB) { $status = "added" }
    elseif ($inA -and $inB) {
        $fA = $filesA[$path]
        $fB = $filesB[$path]
        if ($fA.Length -ne $fB.Length) {
            $status = "modified"
        } else {
            $hashA = (Get-FileHash -LiteralPath $fA.FullName -Algorithm MD5).Hash
            $hashB = (Get-FileHash -LiteralPath $fB.FullName -Algorithm MD5).Hash
            if ($hashA -ne $hashB) { $status = "modified" }
            else { continue }
        }
    }
    
    $oldText = ""
    $newText = ""
    $binary = $false
    $large = $false
    
    if ($inA) {
        $bytes = [IO.File]::ReadAllBytes($filesA[$path].FullName)
        if ($bytes.Length -gt 0 -and ($bytes -contains 0)) { $binary = $true }
        else { $oldText = [IO.File]::ReadAllText($filesA[$path].FullName, [Text.Encoding]::UTF8).Replace("`r`n", "`n") }
    }
    if ($inB -and -not $binary) {
        $bytes = [IO.File]::ReadAllBytes($filesB[$path].FullName)
        if ($bytes.Length -gt 0 -and ($bytes -contains 0)) { $binary = $true }
        else { $newText = [IO.File]::ReadAllText($filesB[$path].FullName, [Text.Encoding]::UTF8).Replace("`r`n", "`n") }
    }
    
    $absA = if ($inA) { $filesA[$path].FullName } else { "" }
    $absB = if ($inB) { $filesB[$path].FullName } else { "" }
    if ($binary) {
        $diffData += @{ path = $path; status = $status; binary = $true; large = $false; oldText = ""; newText = ""; absA = $absA; absB = $absB }
    } else {
        $oldLines = if ($oldText) { $oldText.Split("`n").Length } else { 0 }
        $newLines = if ($newText) { $newText.Split("`n").Length } else { 0 }
        
        if ($oldLines -gt 3000 -or $newLines -gt 3000) { $large = $true }
        
        $diffData += @{ path = $path; status = $status; binary = $false; large = $large; oldText = $oldText; newText = $newText; absA = $absA; absB = $absB }
    }
    } catch {
        $skipped += $path
    }
}

Write-Host "Found $($diffData.Count) changed files."
if ($skipped.Count -gt 0) { Write-Host "Warning: $($skipped.Count) file(s) skipped (locked/unreadable):" -ForegroundColor Yellow; $skipped | Select-Object -First 20 | ForEach-Object { Write-Host "  - $_" -ForegroundColor DarkYellow }; if ($skipped.Count -gt 20) { Write-Host "  ... and $($skipped.Count - 20) more" -ForegroundColor DarkYellow } }

if ($diffData.Count -eq 0) {
    $arrJson = "[]"
} elseif ($diffData.Count -eq 1) {
    $arrJson = "[$($diffData[0] | ConvertTo-Json -Depth 4 -Compress)]"
} else {
    $arrJson = $diffData | ConvertTo-Json -Depth 4 -Compress
}
$meta = @{ dirA = $dirA; dirB = $dirB; count = $diffData.Count } | ConvertTo-Json -Compress
$json = "{""meta"":$meta,""diffs"":$arrJson}"

$jsonBytes = [Text.Encoding]::UTF8.GetBytes($json)
$b64 = [Convert]::ToBase64String($jsonBytes)

# 解码内嵌的 HTML 模板
$htmlB64 = ""
$htmlBytes = [Convert]::FromBase64String($htmlB64)
$htmlTemplate = [Text.Encoding]::UTF8.GetString($htmlBytes)

$htmlContent = $htmlTemplate.Replace("__B64_DATA__", $b64)

$resultHtml = Join-Path $PSScriptRoot "diff_result.html"
try {
    [IO.File]::WriteAllText($resultHtml, $htmlContent, [Text.UTF8Encoding]::new($false))
    Write-Host "Result generated: $resultHtml"
    Write-Host "Opening browser..."
    Start-Process $resultHtml
} catch {
    Write-Host "Error: cannot write/open result file: $resultHtml" -ForegroundColor Red
    Write-Host "  $($_.Exception.Message)" -ForegroundColor Red
    Write-Host "  (close the file in browser/editor and retry)" -ForegroundColor Red
    exit 2
}